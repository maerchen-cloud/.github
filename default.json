{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigestsToSemver"],
  "semanticCommits": "enabled",
  "timezone": "Asia/Tokyo",
  "schedule": ["on monday"],
  "automergeStrategy": "squash",
  "minimumReleaseAge": "7 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "0.x の minor の更新は互換性を壊しうるため自動マージしない",
      "matchUpdateTypes": ["minor"],
      "matchCurrentVersion": "/^v?0\\./",
      "automerge": false
    },
    {
      "description": "Python の minor と patch を分け、minor の更新をマージする前も patch の更新を作成する",
      "matchDepNames": ["python"],
      "separateMinorPatch": true
    },
    {
      "description": "Python の minor と major の更新は互換性を壊しうるため 90 日保留し自動マージしない",
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["minor", "major"],
      "minimumReleaseAge": "90 days",
      "automerge": false
    },
    {
      "description": "組織内の再利用可能なワークフローは変更を即座に伝播させるため digest を固定しない",
      "matchDepNames": ["maerchen-cloud/.github"],
      "pinDigests": false
    }
  ]
}
